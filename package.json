{
    "name": "uu-bootstrap",
    "version": "1.5.0-alpha.1",
    "description": "UU theme for bootstrap + several extensions ",
    "repository": "git@github.com:DH-IT-Portal-Development/bootstrap-theme.git",
    "author": "DH-IT Portal development",
    "license": "EUPL-1.2",
    "keywords": [
        "css",
        "sass",
        "mobile-first",
        "responsive",
        "front-end",
        "framework",
        "web"
    ],
    "sass": "scss/bootstrap.scss",
    "style": "dist/css/bootstrap.css",
    "files": [
        "scss/**/*.scss"
    ],
    "scripts": {
        "build": "yarn _build dist/css/bootstrap.css && yarn _build dist/css/bootstrap.min.css --style=compressed",
        "_build": "SASS_PATH=node_modules sass -I . scss/bootstrap.scss",
        "watch": "yarn _build dist/css/bootstrap.css --watch",
        "format": "prettier -w ."
    },
    "dependencies": {
        "bootstrap": "5.3.1"
    },
    "devDependencies": {
        "prettier": "3.0.3",
        "sass": "^1.89.2"
    },
    "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
